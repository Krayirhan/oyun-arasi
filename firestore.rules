rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function knownGame(gameId) {
      return gameId in ['2048', 'series', 'xox', 'hafiza', 'mayin-tarlasi', 'sudoku', 'sekil', 'kelime-avi', 'tetris', 'soliter', 'mahjong', 'araba', 'platform-macera', 'tavla', 'okey', 'pisti', 'dort-tas']
        || gameId.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validGameStats(value) {
      return value is map
        && value.keys().hasOnly(['2048', 'harfane', 'xox', 'hafiza', 'mayin-tarlasi', 'sudoku', 'sekil', 'kelime-avi', 'tetris', 'soliter', 'mahjong', 'araba', 'platform-macera', 'tavla', 'okey', 'pisti', 'dort-tas'])
        && (!('2048' in value) || value['2048'] is map)
        && (!('harfane' in value) || value.harfane is map)
        && (!('xox' in value) || value.xox is map)
        && (!('hafiza' in value) || value.hafiza is map)
        && (!('mayin-tarlasi' in value) || value['mayin-tarlasi'] is map)
        && (!('sudoku' in value) || value.sudoku is map)
        && (!('sekil' in value) || value.sekil is map)
        && (!('kelime-avi' in value) || value['kelime-avi'] is map)
        && (!('tetris' in value) || value.tetris is map)
        && (!('soliter' in value) || value.soliter is map)
        && (!('mahjong' in value) || value.mahjong is map)
        && (!('araba' in value) || value.araba is map)
        && (!('platform-macera' in value) || value['platform-macera'] is map)
        && (!('tavla' in value) || value.tavla is map)
        && (!('okey' in value) || value.okey is map)
        && (!('pisti' in value) || value.pisti is map)
        && (!('dort-tas' in value) || value['dort-tas'] is map);
    }

    // Favoriler ve son oynananlar (library.js); en fazla 12'şer öğe.
    function validLibrary(value) {
      return value is map
        && value.keys().hasOnly(['favorites', 'favoritesUpdatedAt', 'recent'])
        && (!('favorites' in value) || (value.favorites is list && value.favorites.size() <= 12))
        && (!('recent' in value) || (value.recent is list && value.recent.size() <= 12))
        && (!('favoritesUpdatedAt' in value) || value.favoritesUpdatedAt is int);
    }

    function validProfile(data) {
      return data.keys().hasOnly(['schemaVersion', 'email', 'displayName', 'createdAt', 'lastSeenAt', 'gameStats', 'library'])
        && (!('library' in data) || validLibrary(data.library))
        && data.keys().hasAll(['schemaVersion', 'email', 'displayName', 'lastSeenAt', 'gameStats'])
        && data.schemaVersion == 2
        && data.email is string && data.email.size() <= 320
        && data.displayName is string && data.displayName.size() <= 80
        && data.lastSeenAt is timestamp
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && validGameStats(data.gameStats);
    }

    function validPlatformGame(gameId, data) {
      return gameId in ['2048', 'xox', 'hafiza', 'mayin-tarlasi', 'sudoku', 'sekil', 'kelime-avi', 'tetris', 'soliter', 'mahjong', 'araba', 'platform-macera', 'tavla', 'okey', 'pisti', 'dort-tas']
        && data.keys().hasOnly(['gameId', 'schemaVersion', 'state', 'stats', 'updatedAt', 'clientUpdatedAt', 'deviceCounters'])
        && data.keys().hasAll(['gameId', 'schemaVersion', 'state', 'stats', 'updatedAt'])
        && data.gameId == gameId && data.schemaVersion == 1
        && data.state is map && data.state.keys().size() <= 64
        && data.stats is map && data.stats.keys().size() <= 32
        && data.updatedAt is timestamp
        && (!('clientUpdatedAt' in data) || (data.clientUpdatedAt is int && data.clientUpdatedAt >= 0))
        && (!('deviceCounters' in data) || (data.deviceCounters is map && data.deviceCounters.keys().size() <= 20));
    }

    function roomMember(data) {
      return request.auth != null && (request.auth.uid == data.hostUid || request.auth.uid == data.guestUid);
    }

    function validRoom(data) {
      return data.keys().hasOnly(['gameId', 'code', 'hostUid', 'guestUid', 'status', 'state', 'turn', 'version', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['gameId', 'code', 'hostUid', 'guestUid', 'status', 'state', 'turn', 'version', 'createdAt', 'updatedAt'])
        && data.gameId == 'dort-tas' && data.code is string && data.code.matches('^[A-Z0-9]{6}$')
        && data.hostUid is string && data.guestUid is string && data.hostUid != data.guestUid
        && data.status in ['waiting', 'playing', 'complete'] && data.turn in [0, 1]
        && data.version is int && data.version >= 0 && data.version < 10000
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (data.state == null || (data.state is map && data.state.keys().hasOnly(['board', 'current', 'starter', 'winner', 'winningLine', 'scores', 'draws', 'status', 'mode', 'level', 'moveCount'])
          && data.state.board is list && data.state.board.size() == 42 && data.state.current in [0, 1]
          && data.state.moveCount is int && data.state.moveCount >= 0 && data.state.moveCount <= 42
          && data.state.mode == 'online' && data.state.status in ['playing', 'won', 'draw']));
    }

    function roomSeat(data) {
      return request.auth.uid == data.hostUid ? 0 : request.auth.uid == data.guestUid ? 1 : -1;
    }

    function validHarfaneGame(gameId, data) {
      return (gameId.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$') && data.mode == 'daily'
          && data.date == gameId[6:] && data.guesses is list && data.guesses.size() <= 6)
        || (gameId == 'series' && data.mode == 'series'
          && data.order is list && data.order.size() == 70 && data.level is int
          && data.level >= 1 && data.level <= 71 && data.guesses is list && data.guesses.size() <= 6);
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create: if signedInAs(userId) && validProfile(request.resource.data);
      allow update: if signedInAs(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['schemaVersion', 'email', 'displayName', 'lastSeenAt', 'gameStats', 'library'])
        && validProfile(request.resource.data);
      // Hesap silme: kullanıcı kendi profilini ve oyun belgelerini silebilir.
      allow delete: if signedInAs(userId);

      match /games/{gameId} {
        allow get: if signedInAs(userId) && knownGame(gameId);
        allow list: if signedInAs(userId);
        allow create, update: if signedInAs(userId) && knownGame(gameId)
          && (validPlatformGame(gameId, request.resource.data)
            || (gameId in ['series'] || gameId.matches('^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
              && request.resource.data.keys().hasOnly(['date', 'mode', 'level', 'seriesWins', 'seriesBest', 'completed', 'completedRuns', 'order', 'puzzleNumber', 'guesses', 'current', 'levelCounted', 'gameOver', 'won', 'attempts', 'completedAt'])
              && validHarfaneGame(gameId, request.resource.data));
        allow delete: if signedInAs(userId);
      }
    }

    match /rooms/{roomId} {
      allow get: if request.auth != null && (roomMember(resource.data) || resource.data.status == 'waiting');
      allow list: if false;
      allow create: if request.auth != null && validRoom(request.resource.data)
        && roomId == request.resource.data.code && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == '' && request.resource.data.status == 'waiting'
        && request.resource.data.state == null && request.resource.data.turn == 0 && request.resource.data.version == 0;
      allow update: if request.auth != null && validRoom(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guestUid', 'status', 'state', 'turn', 'version', 'updatedAt'])
        && request.resource.data.gameId == resource.data.gameId && request.resource.data.code == resource.data.code
        && request.resource.data.hostUid == resource.data.hostUid && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.version == resource.data.version + 1
        && ((resource.data.status == 'waiting' && resource.data.guestUid == ''
            && request.resource.data.guestUid == request.auth.uid && request.auth.uid != resource.data.hostUid
            && request.resource.data.status == 'playing' && request.resource.data.turn == 0
            && request.resource.data.state.status == 'playing' && request.resource.data.state.moveCount == 0)
          || (resource.data.status == 'playing' && roomMember(resource.data)
            && resource.data.turn == roomSeat(resource.data)
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.state.moveCount == resource.data.state.moveCount + 1
            && request.resource.data.state.current == request.resource.data.turn
            && request.resource.data.turn in [roomSeat(resource.data), 1 - roomSeat(resource.data)]
            && request.resource.data.status in ['playing', 'complete']
            && ((request.resource.data.status == 'playing' && request.resource.data.turn == 1 - roomSeat(resource.data)
                && request.resource.data.state.status == 'playing')
              || (request.resource.data.status == 'complete' && request.resource.data.turn == roomSeat(resource.data)
                && request.resource.data.state.status in ['won', 'draw']))));
      allow delete: if false;
    }
  }
}
